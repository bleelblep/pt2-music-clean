<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Battery-optimization exemption is the documented way for an app without a
         visible activity to start a foreground service from the background. Playback
         is always triggered by the watch (via the Pebble app's bound service), so
         without this exemption Android 12+ blocks the foreground promotion, which in
         turn suppresses the media notification and lets the system freeze playback. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Package visibility so SessionToken() can resolve Symfonium's MediaBrowserService
         (see SymfoniumPlaybackService). Without this, PackageManager's queryIntentServices
         returns nothing for app.symfonik.music.player even though it's exported. -->
    <queries>
        <package android:name="app.symfonik.music.player" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".PebbleMusicService"
            android:exported="true">
            <intent-filter>
                <action android:name="io.rebble.pebblekit2.RECEIVE_DATA_FROM_WATCH" />
            </intent-filter>
        </service>
        <service
            android:name=".PebblePlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
        <service
            android:name=".SymfoniumPlaybackService"
            android:exported="true" />
    </application>
</manifest>
