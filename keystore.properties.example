# Release signing credentials for :pebble-companion.
#
# Copy this file to keystore.properties (same directory) and fill in your own values.
# keystore.properties is gitignored and must stay that way - it holds real passwords.
# Without it the release build is left unsigned rather than failing, so a fresh clone
# still builds.

storeFile=/absolute/path/to/keystore.jks
storePassword=
keyAlias=
keyPassword=
