          {"label": "Watch", "value": "0"},
          {"label": "Phone", "value": "1"}
        ]
      },
      {
        "type": "slider",
        "messageKey": "CONFIG_WATCH_VOLUME",
        "label": "Watch volume",
        "defaultValue": 50,
        "min": 0,
        "max": 100,
        "step": 10
      },
      {
        "type": "slider",
        "messageKey": "CONFIG_PHONE_VOLUME",
