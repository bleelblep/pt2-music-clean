      {
        "type": "select",
        "messageKey": "CONFIG_PHONE_AUDIO_QUALITY",
        "label": "Phone stream quality",
        "defaultValue": "1",
        "options": [
          {"label": "Data Saver", "value": "0"},
          {"label": "High", "value": "1"}
        ]
      }
    ]
  },
  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "defaultValue": "Search"
      },
      {
        "type": "select",
        "messageKey": "CONFIG_INPUT_MODE",
        "label": "Default input",
