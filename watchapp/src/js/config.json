        "options": [
          {"label": "Voice", "value": "0"},
          {"label": "Keyboard", "value": "1"},
          {"label": "Ask every time", "value": "2"}
        ]
      },
      {
        "type": "toggle",
        "messageKey": "CONFIG_SHOW_PROGRESS",
